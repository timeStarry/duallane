{
  "name": "@duallane/web",
  "version": "0.15.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"node --watch server/index.mjs\" \"vite --host 0.0.0.0\"",
    "build": "tsc -b && vite build",
    "db:migrate": "node server/migrate.mjs",
    "storage:dedupe": "node server/storage-dedupe.mjs",
    "storage:migrate": "node server/storage-migrate.mjs",
    "storage:provision": "node server/storage-provision.mjs",
    "start": "NODE_ENV=production node server/index.mjs",
    "test": "vitest run",
    "test:postgres": "vitest run server/postgres.integration.test.js",
    "lint": "tsc -b --pretty false"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1105.0",
    "@aws-sdk/lib-storage": "^3.1105.0",
    "@aws-sdk/s3-request-presigner": "^3.1105.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/static": "^8.3.0",
    "@fastify/websocket": "^11.2.0",
    "@lexical/react": "^0.49.0",
    "@lexical/utils": "^0.49.0",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "fastify": "^5.6.2",
    "lexical": "^0.49.0",
    "lucide-react": "^0.561.0",
    "mdast-util-to-string": "^4.0.0",
    "nodemailer": "^7.0.12",
    "pg": "^8.16.3",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-easy-crop": "^6.2.3",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "sharp": "^0.35.3",
    "strip-markdown": "^6.0.0",
    "undici": "^7.29.0",
    "unified": "^11.0.5",
    "vite": "^7.2.7"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  }
}
