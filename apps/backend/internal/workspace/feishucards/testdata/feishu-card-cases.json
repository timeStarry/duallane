          ]},
          {"tag": "columns", "columns": [
            {"tag": "column", "width": "weighted", "weight": 1, "elements": [
              {"tag": "div", "text": {"tag": "plain_text", "content": "左列"}}
            ]},
            {"tag": "column", "width": "auto", "elements": [
              {"tag": "markdown", "content": "[右列](https://example.com/right)"}
            ]}
          ]}
        ]
      }
    },
    {
      "name": "button-list-and-button-styles",
      "input": {
        "elements": [
          {"tag": "button_list", "buttons": [
            {"tag": "button", "text": "取消", "value": {"action_id": "cancel"}},
            {"tag": "button", "text": {"tag": "plain_text", "content": "刷新"}, "type": "danger", "value": {"action_id": "refresh", "data": {"mode": "synthetic"}}},
            {"tag": "button", "text": "提交", "value": {"action_id": "submit", "data": null}}
          ]}
        ]
      }
    },
    {
      "name": "ordered-data-and-lone-surrogate",
      "input": {
        "elements": [
          {"tag": "action", "actions": [
            {"tag": "button", "text": "确认", "value": {"action_id": "confirm", "data": {"z": "first", "0": "zero", "z": "last", "a": "first", "surrogate": "\ud800"}}}
          ]}
        ]
      }
    },
    {
      "name": "nested-columns-and-reconstruction",
      "input": {
        "elements": [
          {"tag": "column_set", "columns": [
            {"tag": "column", "elements": [
              {"tag": "action", "actions": [
                {"tag": "button", "text": {"tag": "plain_text", "content": "确认"}, "value": {"action_id": "confirm", "data": {"choice": "yes"}}}
              ]}
            ]},
            {"tag": "column", "elements": [
              {"tag": "note", "elements": [{"tag": "plain_text", "content": "列内备注"}]}
            ]}
          ]}
        ]
      }
    }
  ],
  "reconstruction": [
    {
      "name": "canonical-payload-reconstruction",
      "payload": {
        "format": "duallane.feishu-card.v1",
        "config": {"version": "1.0", "wideScreen": false},
        "header": {"title": "重建", "subtitle": "合成", "tone": "warning"},
        "elements": [
          {"type": "text", "format": "plain", "text": "正文"},
          {"type": "text", "format": "markdown", "text": "[链接](https://example.com/rebuild)"},
          {"type": "note", "parts": [{"format": "plain", "text": "备注"}]},
          {"type": "divider"},
          {"type": "actions", "buttons": [{"type": "button", "label": "提交", "actionId": "submit", "style": "default", "data": {"z": "first", "0": "zero", "z": "last", "a": "first", "surrogate": "\ud800"}}]},
          {"type": "columns", "columns": [{"width": "weighted", "weight": 1, "elements": [{"type": "text", "format": "plain", "text": "列"}]}, {"width": "auto", "elements": [{"type": "divider"}]}]}
        ]
      }
    }
  ],
  "errors": [
