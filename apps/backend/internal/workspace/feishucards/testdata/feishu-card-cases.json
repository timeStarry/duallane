    {"name": "too-many-nodes", "input": {"elements": "__REPLACE_WITH_81_HR__"}, "code": "card.payload_too_complex"},
    {"name": "private-mapped-ipv6", "input": {"elements": [{"tag": "markdown", "content": "[local](https://[::ffff:127.0.0.1]/admin)"}]}, "code": "card.private_url"}
