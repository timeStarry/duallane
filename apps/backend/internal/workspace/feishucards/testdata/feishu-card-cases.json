    {"name": "private-host-suffix", "input": {"elements": [{"tag": "markdown", "content": "[local](https://service.internal/admin)"}]}, "code": "card.private_url"},
    {"name": "cleartext-url", "input": {"elements": [{"tag": "markdown", "content": "[clear](http://example.com/)"}]}, "code": "card.url_forbidden"},
    {"name": "unknown-action", "input": {"elements": [{"tag": "action", "actions": [{"tag": "button", "text": {"tag": "plain_text", "content": "运行"}, "value": {"action_id": "run_script"}}]}]}, "code": "card.unknown_action"},
    {"name": "duplicate-action", "input": {"elements": [{"tag": "action", "actions": [{"tag": "button", "text": {"tag": "plain_text", "content": "确认"}, "value": {"action_id": "confirm"}}, {"tag": "button", "text": {"tag": "plain_text", "content": "再次确认"}, "value": {"action_id": "confirm"}}]}]}, "code": "card.feishu_duplicate_action"},
    {"name": "unknown-element", "input": {"elements": [{"tag": "img", "img_key": "synthetic"}]}, "code": "card.feishu_unknown_element"},
    {"name": "unknown-field", "input": {"style": {"color": "red"}, "elements": [{"tag": "hr"}]}, "code": "card.feishu_unknown_field"},
    {"name": "unsupported-version", "input": {"config": {"version": "2.0"}, "elements": [{"tag": "hr"}]}, "code": "card.feishu_unsupported_version"},
