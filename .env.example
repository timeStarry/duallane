DUALLANE_WEB_BIND=127.0.0.1
DUALLANE_WEB_PORT=8787
SESSION_SECRET=replace-with-a-long-random-secret
PUBLIC_BASE_URL=http://127.0.0.1:8787
WORKSPACE_ENABLED=false
# Leave empty for same-origin Compose. Set http://127.0.0.1:5173 only for local Vite development.
WORKSPACE_FRONTEND_URL=
TRUST_PROXY=true

# PostgreSQL. Compose passes POSTGRES_* as discrete PG* connection fields and
# runs migrations before the API starts. DATABASE_URL is for direct dev/start.
POSTGRES_IMAGE=docker.m.daocloud.io/library/postgres:17-alpine
POSTGRES_DB=duallane
POSTGRES_USER=duallane
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
DATABASE_URL=postgresql://duallane:replace-with-a-long-random-database-password@127.0.0.1:5432/duallane
DATABASE_AUTO_MIGRATE=true
DATABASE_POOL_MAX=10
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Optional WebRTC fallback. Prefer turns: URLs and a short-lived coturn REST secret.
DUALLANE_STUN_URLS=stun:stun.l.google.com:19302
DUALLANE_TURN_URLS=
DUALLANE_TURN_SHARED_SECRET=
DUALLANE_TURN_TTL_SECONDS=600
DUALLANE_TURN_USERNAME=
DUALLANE_TURN_CREDENTIAL=
DUALLANE_EMPTY_ROOM_GRACE_MS=10000

# Optional for local shared-space debugging. Required in production when
# WORKSPACE_ENABLED=true. Without these in non-production, GitHub login uses
# the seeded owner fallback: timeStarry / timestarry@qq.com.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Total budget shared by the GitHub token, profile, and email requests.
GITHUB_OAUTH_TIMEOUT_MS=8000

# Optional GitHub-only outbound proxy. Leave the profile and proxy URL empty
# unless this host cannot reach GitHub OAuth endpoints directly.
COMPOSE_PROFILES=
GITHUB_PROXY_URL=
V2RAY_IMAGE=dockerproxy.net/v2fly/v2fly-core@sha256:d06727b221fe8cbaed2dd1d23f9d8270cb6581dc1c2c2949bd4d04d4c332eee3
V2RAY_SUBSCRIPTION_FILE=./deploy/v2ray/subscription-url.example
